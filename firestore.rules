rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn()   { return request.auth != null; }
    function isAdmin()    { return signedIn() && request.auth.token.email == 'deepvernekar1097@gmail.com'; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function activeOwner(uid) {
      return isOwner(uid) &&
        (!exists(/databases/$(database)/documents/users/$(uid)) ||
         get(/databases/$(database)/documents/users/$(uid)).data.get('removed', false) != true);
    }

    match /users/{uid} {
      allow read:   if isOwner(uid) || isAdmin();
      allow create: if isAdmin() || (isOwner(uid) && request.resource.data.get('removed', false) == false);
      allow update: if isAdmin() || (activeOwner(uid) && request.resource.data.get('removed', false) == false);
      allow delete: if isAdmin();

      match /{sub}/{docId} {
        allow read:           if activeOwner(uid) || isAdmin();
        allow create, update: if activeOwner(uid);
        allow delete:         if activeOwner(uid) || isAdmin();
      }
    }

    match /secrets/{uid} {
      allow read, write: if isAdmin();
    }
  }
}
